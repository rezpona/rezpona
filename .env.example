# Rezpona — configuration reference
#
# This is a STATIC site (Netlify, no build step). There is NO server reading these
# values at runtime — anything shipped in an HTML/JS file is visible in the browser.
# This file only documents where each value belongs so the setup is reproducible.

# ── Supabase (PUBLIC) ──────────────────────────────────────────────
# The anon key is designed to be public and is already inlined in the HTML pages.
SUPABASE_URL=https://upepsbyqqefdaygmjxie.supabase.co
SUPABASE_ANON_KEY=__public_anon_key__   # safe in the browser; see login.html / dashboard.html

# ── Google OAuth (SECRET — never put these in the repo or any frontend file) ──
# Enter these ONLY in the Supabase Dashboard:
#   Authentication -> Providers -> Google -> (enable) -> Client ID + Client Secret
# Supabase stores the secret server-side and performs the OAuth token exchange.
GOOGLE_OAUTH_CLIENT_ID=__from_google_cloud_console__
GOOGLE_OAUTH_CLIENT_SECRET=__paste_into_supabase_dashboard_only__

# ── Supabase Edge Function secrets (set via `supabase secrets set ...`) ──
# These live in the Supabase Functions runtime, never in the browser.
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
GOOGLE_CLIENT_ID=__same_as_above__
GOOGLE_CLIENT_SECRET=__same_secret__
ALLOWED_ORIGIN=https://rezpona.com
CRON_SECRET=__long_random_string_for_the_autopilot_cron__
